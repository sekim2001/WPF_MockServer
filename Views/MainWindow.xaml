<Window x:Class="WPF_MockServer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_MockServer"
        xmlns:vm="clr-namespace:WPF_MockServer.ViewModels"
        mc:Ignorable="d" Background="#1B1E2A"
        Title="Mock Server" Height="700" Width="1200">

    <Window.DataContext>
        <vm:MainWinodwViewModel/>
    </Window.DataContext>
    
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!--#region 장치 목록-->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition />
            </Grid.RowDefinitions>
            
            <GroupBox Header="장치 추가" Style="{StaticResource MainPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Bind IP" Foreground="#DBDBDB" FontSize="11"/>
                    <ComboBox Grid.Row="1" Grid.Column="0"
                              ItemsSource="{Binding AvailableIps}"
                              SelectedItem="{Binding SelectedBindIp}"/>

                    <TextBlock Text="Bind Port" Foreground="#DBDBDB" FontSize="11" Grid.Column="1" Margin="10,0,0,0"/>
                    <TextBox Grid.Column="1" Grid.Row="1" Margin="10,0,0,0" Text="{Binding BindPort, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxStyle}">
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Style.Triggers>
                                    <Trigger Property="Validation.HasError" Value="True">
                                        <Setter Property="BorderBrush" Value="Red"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <TextBlock Text="Destination IP" Foreground="#DBDBDB" FontSize="11" Grid.Row="2" Margin="0,5,0,0"/>
                    <TextBox Grid.Row="3" Style="{StaticResource TextBoxStyle}" Text="{Binding DstIpString}"/>

                    <TextBlock Text="Bind Port" Foreground="#DBDBDB" FontSize="11" 
                               Grid.Column="1" Grid.Row="2" Margin="10,5,0,0"/>
                    <TextBox Grid.Column="1" Grid.Row="3" Margin="10,0,0,0" Style="{StaticResource TextBoxStyle}"
                             Text="{Binding DstPortString}"/>

                    <TextBlock Text="Protocol" Grid.Row="4" Foreground="#DBDBDB" FontSize="11" Margin="0,5,0,0"/>
                    <Border Grid.Row="5" Grid.ColumnSpan="2" CornerRadius="2"
                            Background="#1B1F2B" BorderBrush="#484E61" BorderThickness="1">
                        <Grid Height="25">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <RadioButton Content="UDP" Style="{StaticResource RectangleRadioButtonStyle}" Margin="2" IsChecked="{Binding IsSelectedUdp}"/>
                            <RadioButton Content="TCP" Grid.Column="1" Style="{StaticResource RectangleRadioButtonStyle}" Margin="2" />
                        </Grid>
                    </Border>
                </Grid>
            </GroupBox>

            <Button Content="ADD" Style="{StaticResource btn_Panel}" Width="50"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Command="{Binding AddDeviceCommand}"/>

            <GroupBox Style="{StaticResource MainPanelStyle}" Grid.Row="2" Header="장치 목록">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <GroupBox Margin="3,0" Header="{Binding Id}" HeaderStringFormat="Device {0}" Style="{StaticResource SubPanelStyle}">
                                    <StackPanel>
                                        <TextBlock FontSize="11" Foreground="White">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Source : {0} / {1}">
                                                    <Binding Path="BindIp"/>
                                                    <Binding Path="BindPort"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="White" Margin="0,5">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="Destination : {0} / {1}">
                                                    <Binding Path="DstIp"/>
                                                    <Binding Path="DstPort"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                        <Grid>
                                            <TextBlock FontSize="11" Foreground="White">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Protocol : TCP"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsUdp}" Value="true">
                                                                <Setter Property="Text" Value="Protocol : UDP"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Style="{StaticResource btn_Panel}" HorizontalAlignment="Right" Content="DEL" Width="80" 
                                                    CommandParameter="{Binding Id}" 
                                                    Command="{Binding DataContext.DeleteDeviceCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                                        </Grid>
                                    </StackPanel>
                                </GroupBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl> 
                </ScrollViewer>
            </GroupBox>
        </Grid>
        <!--#endregion-->
        
        <!--#region 패킷 데이터-->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <ListBox ItemsSource="{Binding Devices}" 
                     SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0"
                     HorizontalAlignment="Left" Height="27" Grid.Column="1">

                <!-- 가로로 나열하기 -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <!-- 기본 ListBoxItem 스타일 제거 -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <!-- 내부 아이템을 RadioButton으로 구성 -->
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- IsChecked 속성을 부모 ListBoxItem의 IsSelected 속성과 상대 참조로 바인딩 -->
                        <RadioButton Style="{StaticResource NavigationButtonStyle}" 
                                     Content="{Binding Id}" 
                                     ContentStringFormat="Device {0}" 
                                     IsChecked="{Binding Path=IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}, Mode=TwoWay}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="1" Background="#252B38" CornerRadius="2">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="수동 패킷 송신" Style="{StaticResource SubPanelStyle}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ControlWord (Hex)" Foreground="#DBDBDB" FontSize="11"
                               VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" Margin="10,0" Grid.Column="1"
                             Text="dsdds"/>
                                <Button Style="{StaticResource btn_Panel}" Grid.Column="2" Width="80" Content="전송"/>
                            </Grid>

                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Data (Hex)" Foreground="#DBDBDB" FontSize="11" VerticalAlignment="Center"/>
                                <TextBox Style="{StaticResource TextBoxStyle}" Grid.Column="1" Margin="10,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="패킷 로그 화면" Style="{StaticResource SubPanelStyle}" Grid.Row="1" Margin="0,5">
                        <DataGrid Background="Transparent" BorderThickness="0">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="LightGray"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="LightGray"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Height" Value="20"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="Foreground" Value="#DBDBDB"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="시각" Width="120" FontSize="11" Foreground="#DBDBDB"
                                                Binding="{Binding TimeStamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"/>
                                <DataGridTextColumn Header="Type" Width="100" FontSize="11" Foreground="#DBDBDB"/>
                                <DataGridTextColumn Header="LEN" Width="50" FontSize="11" Foreground="#DBDBDB"/>
                                <DataGridTextColumn Header="CW" Width="50" FontSize="11" Foreground="#DBDBDB"/>
                                <DataGridTextColumn Header="Data" Width="*" FontSize="11" Foreground="#DBDBDB"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GroupBox Header="Smart Responses 관리" Style="{StaticResource SubPanelStyle}" Grid.Row="2">

                    </GroupBox>
                </Grid>
            </Border>
        </Grid>
        <!--#endregion-->
    </Grid>
</Window>
